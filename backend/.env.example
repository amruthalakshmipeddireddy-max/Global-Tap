# Copy this file to ".env" and fill in your own Supabase project values.
# Never commit ".env" to git. Never share these values in chat.
#
# Where to find them: Supabase Dashboard -> your project -> Settings -> API.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Port the backend listens on.
PORT=5000

# The address your frontend is served from (used for CORS).
FRONTEND_URL=http://localhost:8000
